{
  "manifest_version": 3,
  "name": "Marketplace Transfer — связь с приложением",
  "version": "0.1.1",
  "description": "Чтение объявлений и заполнение черновиков Авито через локальное приложение. Без доступа к cookies.",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://avito.ru/*",
    "https://*.avito.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "key": ""
}
